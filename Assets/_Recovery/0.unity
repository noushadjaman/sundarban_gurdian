  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9, g: 0.92, b: 0.95, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: b0395f2455dde2f47a4bfbb4cf80b420, type: 3}
    m_FontSize: 13
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.25
  m_Text: "1. MODIS NDVI (MOD13Q1.061):\n\u2022 Measures: Canopy vegetation density and habitat health across the Sundarbans mangrove delta.\n\u2022 Extraction: Retrieved via NASA AppEEARS platform (appeears.earthdatacloud.nasa.gov).\n\n2. MODIS Land Surface Temperature (MOD11A2.061):\n\u2022 Measures: Estuary surface thermal proxy for dolphin and hilsha migration routes.\n\u2022 Extraction: Retrieved directly via NASA AppEEARS platform.\n\n3. Estuary & River Salinity Index (Salinity Source):\n\u2022 Measures: NASA PO.DAAC SMAP L3 SSS (Sea Surface Salinity) combined with BFRI Chandpur station in-situ readings.\n\n4. Ministry of Fisheries & Livestock, Bangladesh (Conservation Campaign):\n\u2022 Measures: 22-day October Mother Hilsa protection ban & Nov 1 - Jun 30 Jatka protection law (52% safe spawning rate in 2024).\n\n5. Satellite Navigation Radar (Minimap Imagery):\n\u2022 Source: NASA Worldview (worldview.earthdata.nasa.gov) \u2014 Landsat-7/8 Optical Earth Observation.\n\n\u26A0\uFE0F Scientific Transparency Note:\nDue to coastal land-masking fill values in open water regions, nearest reliable valid satellite readings were used to provide continuous ecological simulation."
